# Environment for the Anthropic model router (systemd --user).
# Copy to ~/.config/codebuddy-router.env and adjust if needed.

# Port the router listens on (localhost only).
ROUTER_PORT=8788
# Base URL of the local codebuddy2api gateway.
CODEBUDDY_URL=http://127.0.0.1:8787

# --- Optional overrides -------------------------------------------------------
# By default the router reads the fallback provider's base URL and token live
# from ~/.claude/settings.json, so it always tracks whatever your normal Claude
# Code config already points at (and picks up changes without a restart).
# Set the following only if you want to override that behaviour.
#
# FALLBACK_BASE=https://your-provider.example.com/anthropic
# FALLBACK_TOKEN=sk-xxxxxxxxxxxxxxxx
#
# Comma-separated model ids to advertise for the fallback provider in the picker.
# FALLBACK_MODELS=your-model-a,your-model-b
